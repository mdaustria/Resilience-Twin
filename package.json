{
  "name": "resilience-twin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.10.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test scripts/check_bootstrap.mjs",
    "lint": "pnpm --filter @resilience-twin/web lint",
    "typecheck": "pnpm --filter @resilience-twin/web typecheck",
    "build": "pnpm --filter @resilience-twin/web build",
    "generate:client": "uv run python -m scripts.generate_client",
    "check:bootstrap": "node scripts/check_bootstrap.mjs --check",
    "check": "uv run python -m scripts.check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "firebase-tools": "15.30.1",
    "openapi-typescript": "7.13.0"
  }
}
