rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Existing shared-project behavior. Preserve the knowledge upload policy.
    match /knowledge/{documentId}/{fileName} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.token.role == "ADMIN"
        && request.resource.size <= 100 * 1024 * 1024
        && (
          request.resource.contentType == "application/pdf"
          || request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          || request.resource.contentType == "text/plain"
          || request.resource.contentType == "text/markdown"
        );
      allow update, delete: if request.auth != null
        && request.auth.token.role == "ADMIN";
    }

    // Resilience Twin objects are accessed through the owner-checking server.
    match /resilience-twin/{path=**} {
      allow read, write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
